package homemaid:plugin@1.2.0;

/// Capability kinds and values cross the boundary as strings (kind: "on_off", value and meta: JSON),
/// so new capabilities do not break v1. The Rust SDK exposes them typed.
interface types {
    record capability {
        kind: string,
        /// CapMeta as JSON.
        meta: string,
    }

    record entity {
        /// Stable id inside the plugin (e.g. device MAC + outlet index). The core derives the UUID from it.
        local-id: string,
        name: string,
        /// Physical device grouping several entities.
        device: option<string>,
        capabilities: list<capability>,
    }

    record manifest {
        id: string,
        version: string,
        api-version: string,
        permissions: list<string>,
    }

    enum log-level { trace, debug, info, warn, error }
}

/// What the core gives a plugin. Network access goes through wasi:sockets, local network only.
interface host {
    use types.{log-level};

    log: func(level: log-level, message: string);
    /// value is CapValue as JSON.
    report-state: func(local-id: string, kind: string, value: string);
    set-available: func(local-id: string, available: bool);
    /// Private key-value store, persisted by the core.
    kv-get: func(key: string) -> option<string>;
    kv-set: func(key: string, value: string);
    secret: func(name: string) -> option<string>;
}

/// plugin-api 1.1: one-shot actions (media next, lock...). Not states: the reconciler never
/// retries them, and a 1.0 plugin, which has none, keeps working unchanged.
interface action-types {
    record action {
        local-id: string,
        name: string,
        /// JSON schema of the parameters; none takes no parameters.
        params: option<string>,
    }
}

/// plugin-api 1.2: schedules a device runs on its own, so they keep working while the hub is off
/// (a power strip that still switches at sunset with the PC asleep). The core hands over the
/// simple ones and keeps running them itself too: both set the same state.
interface schedule-types {
    /// When in the day, in the device's own time zone.
    variant time-of-day {
        /// Minutes after midnight.
        clock(u16),
        /// Minutes after sunrise (negative: before), the sunrise the device computes itself.
        sunrise(s16),
        /// Minutes after sunset (negative: before).
        sunset(s16),
    }

    record schedule {
        /// The automation it comes from.
        id: string,
        kind: string,
        /// CapValue as JSON.
        value: string,
        at: time-of-day,
        /// Days of the week, Monday = bit 0.
        days: u8,
    }
}

world plugin {
    use types.{entity, manifest};
    import host;

    export manifest: func() -> manifest;
    export init: func(settings: list<tuple<string, string>>) -> result<_, string>;
    export discover: func() -> result<list<entity>, string>;
    /// Applies a desired value. Success is not confirmation: the plugin confirms with report-state,
    /// typically in the refresh the host calls right after (once the queued commands are applied).
    export apply: func(local-id: string, kind: string, value: string) -> result<_, string>;
    /// Called right after commands and between them (adaptive polling; named refresh because `poll`
    /// clashes with libc). Returns the delay in ms before the next call.
    export refresh: func() -> u32;
}

/// A plugin with actions: everything a 1.0 plugin does, plus its actions.
world plugin-with-actions {
    include plugin;
    use action-types.{action};

    export list-actions: func() -> list<action>;
    /// Does the action now; params is JSON (`{}` when it takes none). Success means sent, not
    /// confirmed: an action has no state to confirm.
    export invoke: func(local-id: string, name: string, params: string) -> result<_, string>;
}

/// A plugin whose devices run schedules themselves: everything a 1.1 plugin does, plus that.
world plugin-with-schedules {
    include plugin-with-actions;
    use schedule-types.{schedule};

    /// Replaces every schedule the core handed to this entity before (an empty list removes them).
    /// Never touches the device's other rules (made in the vendor app). Ok: the device holds them,
    /// the app says they run without the hub. Err: it does not (not supported, unreachable); the
    /// plugin may still apply them later, the core runs them anyway.
    export set-schedules: func(local-id: string, schedules: list<schedule>) -> result<_, string>;
}
